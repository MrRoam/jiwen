{
  "name": "jiwen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/start.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/start.js --production",
    "test": "node --test tests/*.test.js",
    "check:openrouter": "node --env-file-if-exists=.env server/check-openrouter.js",
    "setup": "node scripts/setup.js",
    "check:release": "node scripts/check-release.js",
    "backup": "node scripts/backup.js",
    "backup:restore": "node scripts/restore-backup.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "katex": "^0.18.10",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "overrides": {
    "katex": "$katex"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrRoam/jiwen.git"
  }
}
