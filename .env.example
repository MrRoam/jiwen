# npm run setup 创建本机 .env，不会覆盖已有文件。
# 首次使用先配置 SMTP，再通过邮箱验证码注册，从侧栏底部账号菜单的「API 配置」保存密钥。
# 本文件仅提供空密钥和通用默认值；不要提交自己的 .env 或 data/。
PORT=4317
HOST=127.0.0.1
# 独立本机控制台，仅监听 127.0.0.1；设为 0 可关闭。
CONSOLE_PORT=4319
SECURE_COOKIE=false
# 可指定已有邮箱账号作为管理员；留空时新实例的首个邮箱账号为管理员。
ADMIN_EMAIL=
# 自部署版默认允许管理员配置；托管试用设为 false，使用服务器端配置。
# deploy/start-trial.ps1 启动时固定设为 false。
API_CONFIG_ENABLED=true
# Docker 公网部署填写自己的域名，仅主机名，不带协议或路径。
SITE_DOMAIN=

# 推荐：百炼实时转写 + Qwen 问答。页面配置优先于同名环境变量。
DASHSCOPE_API_KEY=
ASR_PROVIDER=remote
ASR_MODEL=fun-asr-realtime
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
# 只会复用到支持的百炼官方地址；其他供应商填写独立密钥。
LLM_USE_ASR_KEY=true

# 账号与额度：程序限制不是云厂商免费额度。每日按 UTC 日期重置。
# 自部署默认 monthly，可自行设置月度额度；公开体验站使用 trial，每账号一次性 3600 秒，不恢复。
ASR_QUOTA_MODE=monthly
MONTHLY_AUDIO_SECONDS=36000
DAILY_QUESTIONS=20
GLOBAL_DAILY_QUESTIONS=800
GLOBAL_REQUESTS_PER_MINUTE=18

# 公测运营披露与存储限制（不要在政策中写未部署的供应商）。
PUBLIC_OPERATOR=姚佳旭
PUBLIC_CONTACT=joshyao0601@gmail.com
PUBLIC_STORAGE_REGION=中国大陆，运营者部署设备
# 使用Cloudflare入口时填cloudflare；直接访问留空。
PUBLIC_ACCESS_PROVIDER=
USER_STORAGE_BYTES=524288000
GLOBAL_STORAGE_BYTES=107374182400
MIN_FREE_DISK_BYTES=21474836480
LESSON_RETENTION_DAYS=30
MAX_RECORDING_SECONDS=7200
MAX_ASR_CONCURRENCY=50
# 云端新任务匀速启动，持续转写并发仍由上面的50路限制。
ASR_STARTS_PER_SECOND=15
GLOBAL_DAILY_ASR_SECONDS=360000
FFMPEG_CONCURRENCY=1
# DATA_DELETION_LOG 使用 data 目录之外的独立文件；默认 DATA_DIR.deletions.jsonl。
# BACKUP_DIR 指向另一个存储设备。备份 CLI 要求服务停止后 --offline。

# 本地转写（可选）：先单独启动 Python 服务，再在页面选择本机转写。
# 云端实时转写时，可单独启用本机后台补转写；需要本地 Python 模型服务。
LOCAL_ASR_RECOVERY=false
LOCAL_ASR_URL=http://127.0.0.1:4318
LOCAL_ASR_MODEL=small
LOCAL_ASR_ENGINE=whisper
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_MAX_STREAMS=50
# GPU流式部署改成paraformer-streaming/cuda，并填已校验的固定模型目录。
# LOCAL_ASR_MODEL_PATH=

# 可选 OpenRouter 优先路由，默认直接使用上面配置的问答接口。
OPENROUTER_API_KEY=
LLM_ROUTING=qwen-only
LLM_FREE_ONLY=true
OPENROUTER_FREE_DAILY_REQUESTS=1000
OPENROUTER_FREE_RESERVE_REQUESTS=100

# 注册邮箱验证与找回密码（开放注册必需；未配置时不能新注册，已有账号可登录）。SMTP_PASS 填服务商授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=即问 <noreply@example.com>

# Jev（可选）：默认关闭，只在显式启用后读取密钥并处理队列。
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_DAILY_REQUESTS=1200
JEV_GLOBAL_DAILY_REQUESTS=6000
TEACHER_QUESTION_DAILY_REQUESTS=200
TEACHER_QUESTION_GLOBAL_DAILY_REQUESTS=1000
