# 个人使用默认无需修改此文件。启动后在「设置 → 转写与问答」填写密钥。
# npm run setup 只创建缺失的 .env，不覆盖已有配置。
# 密钥和个人资料不要提交到 Git。
PORT=4317
HOST=127.0.0.1

# 以下配置也可在页面保存；页面保存的字段优先。
DASHSCOPE_API_KEY=
ASR_PROVIDER=remote
ASR_MODEL=fun-asr-realtime
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
LLM_USE_ASR_KEY=true

# 本机模型可选，按 docs/本地转写.md 准备后使用。
LOCAL_ASR_URL=http://127.0.0.1:4318
LOCAL_ASR_MODEL=small
